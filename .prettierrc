{
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "bracketSpacing": false,
    "trailingComma": "all",
    "proseWrap": "always",
    "tabWidth": 4,
    "overrides": [
        {
            "files": "*.{yaml,yml}",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
