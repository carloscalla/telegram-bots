{
    "name": "telegram-bots",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "tsx --env-file=.env --watch scripts/start-polling.ts",
        "dev:motumbito": "npm run dev motumbito",
        "dev:tipodecambio": "npm run dev tipodecambio",
        "setup-webhook": "tsx --env-file=.env scripts/setup-webhook.ts",
        "setup-webhook:motumbito": "npm run setup-webhook motumbito",
        "setup-webhook:tipodecambio": "npm run setup-webhook tipodecambio",
        "setup-commands": "tsx --env-file=.env scripts/setup-commands.ts",
        "setup-commands:motumbito": "npm run setup-commands motumbito",
        "setup-commands:tipodecambio": "npm run setup-commands tipodecambio",
        "deploy": "vercel --prod",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/carloscalla/telegram-bots.git"
    },
    "author": "Carlos Calla",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/carloscalla/telegram-bots/issues"
    },
    "homepage": "https://github.com/carloscalla/telegram-bots#readme",
    "dependencies": {
        "node-telegram-bot-api": "^0.67.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/node-telegram-bot-api": "^0.64.13",
        "@vercel/node": "^3.0.0",
        "prettier": "^3.8.2",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
}
